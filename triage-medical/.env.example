# === triage-medical / config LLM + RAG ===
# Copier ce fichier en .env et renseigner les valeurs.
# Rien n'est obligatoire : sans clé Groq valide, le service bascule sur Ollama
# local, et si Ollama est absent, le backend Laravel prend le relais (fallback
# par mots-clés). Voir CLAUDE.md §5bis.

# --- Groq (cloud, quota gratuit) : https://console.groq.com -> API Keys ---
# La clé par défaut commitée dans app/config.py est EXPIRÉE : mettre la vôtre ici.
GROQ_API_KEY=
LLM_MODEL_GROQ=llama-3.3-70b-versatile

# --- Ollama (repli local, illimité) : https://ollama.com  puis  ollama pull qwen3:8b ---
LLM_MODEL_OLLAMA=qwen3:8b
OLLAMA_URL=http://localhost:11434/api/chat

# --- Divers ---
CHROMA_PATH=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
CONFIDENCE_THRESHOLD=0.70
