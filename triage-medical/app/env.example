# --- LLM avec fallback automatique ---

Creer un fichier .env identique à celui la, juste remplacer la clé API Groq

# 1. Groq (cloud, gratuit avec quota journalier) est essaye en premier.
# 2. Si Groq echoue (quota depasse, cle absente, erreur reseau),
#    bascule automatiquement sur Ollama (local, illimite).

# Clé API Groq (gratuite sur console.groq.com). Laisser vide pour utiliser Ollama uniquement.
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL_GROQ=llama-3.3-70b-versatile

# Ollama (local) - doit tourner en arrière-plan (http://localhost:11434)
LLM_MODEL_OLLAMA=qwen3:8b
OLLAMA_URL=http://localhost:11434/api/chat

# ChromaDB
CHROMA_PATH=./data/chroma_db

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Seuil de confiance pour validation humaine
CONFIDENCE_THRESHOLD=0.70
