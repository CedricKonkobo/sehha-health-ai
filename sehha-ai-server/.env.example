# sehha-ai-server — modèle de configuration
# Copier vers .env puis renseigner les valeurs.

# Jeton Bearer partagé avec le backend Laravel (obligatoire).
# Doit être IDENTIQUE à OCR_API_KEY / SPEECH_TO_TEXT_KEY / LLM_API_KEY
# dans sehha-backendV2/.env
# Générer une valeur : python -c "import secrets; print(secrets.token_hex(32))"
AI_SERVER_TOKEN=

# Port d'écoute (défaut 8002)
PORT=8002

# STT — faster-whisper
WHISPER_MODEL=base        # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto       # auto | cpu | cuda
WHISPER_COMPUTE=int8      # int8 | float16 | float32
